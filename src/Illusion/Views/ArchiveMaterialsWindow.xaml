<Window x:Class="Illusion.Views.ArchiveMaterialsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Materials of an Archive"
        Width="760" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <!-- Tools → Materials of an archive…: what an archive is drawn with, told apart as the game's own, changed
         or added - and the added and changed ones written out as a material library of their own, the file a
         multiplayer host loads beside the game's. The job is the one behind archive_materials. A mesh names
         its materials by hash and the definitions live in the game's libraries, not in the archive: this is
         the list of what has to travel with it. -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,20,24,20">
            <TextBlock Style="{StaticResource DimLabel}" Text="Archive" Margin="0,0,0,4" />
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ArchiveBox" Grid.Column="0" Padding="6,4" KeyDown="ArchiveBox_KeyDown"
                         ToolTip="A full path to an .sds, or a path under pc\sds such as cars\shubert_38.sds" />
                <Button Grid.Column="1" Style="{StaticResource NeutralButton}" Height="28" Padding="12,0" Margin="8,0,0,0"
                        Content="Browse…" Click="Browse_Click" />
                <Button Grid.Column="2" Style="{StaticResource NeutralButton}" Height="28" Padding="12,0" Margin="8,0,0,0"
                        Content="Read" Click="Read_Click" />
            </Grid>

            <Border Background="{StaticResource FillHairline}" BorderBrush="{StaticResource EdgeFaint}"
                    BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,12">
                <TextBlock x:Name="SummaryText" FontSize="12" Foreground="White" TextWrapping="Wrap"
                           Text="Pick an archive and read it." />
            </Border>

            <CheckBox x:Name="TravelBox" IsChecked="True" Margin="0,0,0,8" Click="Travel_Click"
                      Content="Only what has to travel with the archive (added and changed)" />
            <Border BorderBrush="{StaticResource EdgeFaint}" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                <Grid>
                    <ListBox x:Name="MaterialList" Height="290" BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource PickerItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="54" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="250" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="46" Height="27" CornerRadius="3" Background="#22FFFFFF"
                                            HorizontalAlignment="Left" ClipToBounds="True">
                                        <Image Source="{Binding Thumb}" Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" Foreground="White"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border CornerRadius="3" Padding="6,1" Background="#3E8E6A"
                                                Visibility="{Binding IsAdded, Converter={StaticResource BoolToVis}}"
                                                ToolTip="Not one of the game's: it has to be registered wherever the archive goes">
                                            <TextBlock FontSize="10.5" Foreground="White" Text="added" />
                                        </Border>
                                        <Border CornerRadius="3" Padding="6,1" Background="#8A6A3A"
                                                Visibility="{Binding IsChanged, Converter={StaticResource BoolToVis}}"
                                                ToolTip="One of the game's, defined differently here than the game ships it">
                                            <TextBlock FontSize="10.5" Foreground="White" Text="changed" />
                                        </Border>
                                        <Border CornerRadius="3" Padding="6,1" Background="#B0453F"
                                                Visibility="{Binding IsMissing, Converter={StaticResource BoolToVis}}"
                                                ToolTip="No library has it: these triangles are drawn without a material">
                                            <TextBlock FontSize="10.5" Foreground="White" Text="missing" />
                                        </Border>
                                        <TextBlock FontSize="11" Foreground="{StaticResource TextDim}" Text="the game's own"
                                                   Visibility="{Binding IsShipped, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding DetailText}" FontSize="11"
                                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding TexturesText}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyLabel" Style="{StaticResource DimLabel}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Visibility="Collapsed" />
                </Grid>
            </Border>

            <DockPanel LastChildFill="False" Margin="0,12,0,0">
                <Button x:Name="LibraryBtn" DockPanel.Dock="Left" Style="{StaticResource AccentButton}" Height="30"
                        Padding="14,0" Content="Save as a material library…" IsEnabled="False" Click="Library_Click"
                        ToolTip="The added and changed materials as an .mtl of their own - the file a multiplayer host loads beside the game's libraries" />
                <Button x:Name="ListBtn" DockPanel.Dock="Left" Style="{StaticResource NeutralButton}" Height="30"
                        Padding="12,0" Margin="8,0,0,0" Content="Save the list…" IsEnabled="False" Click="List_Click"
                        ToolTip="Every material shown, with its full definition, as a .json document for whoever takes the archive" />
            </DockPanel>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource FillHairline}" BorderBrush="{StaticResource EdgeFaint}"
                BorderThickness="0,1,0,0" Padding="24,14">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource DimLabel}" MaxWidth="570" TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Text="A mesh names its materials by hash; the definitions live in the game's libraries, not in the archive. Whoever gets the archive without the added and changed ones sees those parts without a material. Nothing of the game is changed here." />
                <Button DockPanel.Dock="Right" Style="{StaticResource NeutralButton}" MinWidth="80" Height="32"
                        Content="Close" IsCancel="True" Click="Close_Click" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
